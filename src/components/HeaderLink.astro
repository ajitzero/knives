---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href: maybeUrl, ...props } = Astro.props;
const href = typeof maybeUrl === 'string' ? maybeUrl : maybeUrl?.href || '/';
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
// Normalize trailing slashes so `/about/`, `/about` and `/` all compare cleanly.
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const subpath = pathname.match(/[^\/]+/g);
const isActive =
	normalize(href) === normalize(pathname) || normalize(href) === '/' + (subpath?.[0] || '');
---

<a href={href} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
