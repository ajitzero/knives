---
import bladesStyles from '@anyblades/blades/layered/blades.layered?inline';
import interStyles from '@fontsource-variable/inter?inline';
import typographyStyles from '../assets/roles/typography.css?inline';
import CopyButton from './CopyButton.astro';

interface Props {
	title: string;
	html: string;
	css: string;
	rtl?: boolean;
	size?: number;
}

const { title, size = 22, html, css, rtl = false } = Astro.props;
const srcdoc = `<!doctype html>
<html lang="en" style="height: 100%;" ${rtl ? 'dir="rtl"' : ''}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">
		<style>${bladesStyles}\n${interStyles}\n${typographyStyles}\n${css}</style>
	</head>
	<body style="height: 100%; min-height: 200px; display: grid; place-items: start center; padding: 2rem 1rem;">
		${html}
	</body>
</html>`;
---

<section class="docs-demo-preview" data-docs-demo-preview>
	{!rtl && <h3>Preview</h3>}

	<iframe
		title={`${title} preview (${rtl ? 'RTL' : 'LTR'})`}
		sandbox=""
		loading="lazy"
		srcdoc={srcdoc}
		style={`height: ${size}rem;`}
	></iframe>

	{!rtl && (
		<div class="docs-demo-preview__sources">
			<section class="docs-demo-preview__source">
				<h3>HTML</h3>
				<pre><code>{html}</code><CopyButton label="HTML" getText={() => html} /></pre>
			</section>
			<section class="docs-demo-preview__source">
				<h3>CSS</h3>
				<pre><code>{css}</code><CopyButton label="CSS" getText={() => css} /></pre>
			</section>
		</div>
	)}
</section>

<style>
	.docs-demo-preview {
		margin-block: 2rem;

		h3 {
			margin-inline: var(--pico-spacing);
			margin-top: var(--pico-typography-spacing-top);
		}

		> h3 {
			margin-bottom: 0.75rem;
		}

		iframe {
			display: block;
			width: 100%;
			border: var(--pico-border-width) solid var(--pico-muted-border-color);
			border-radius: var(--pico-border-radius);
			background: var(--pico-background-color);
			margin-bottom: var(--pico-typography-spacing-vertical);
		}

		pre {
			position: relative;
			overflow: hidden;

			> code {
				max-height: 24rem;
				overflow: auto;
			}

			> :global(button) {
				position: absolute;
				top: 1rem;
				right: 1rem;
				opacity: 0;
				pointer-events: none;
			}

			&:hover > :global(button),
			&:focus-within > :global(button) {
				opacity: 1;
				pointer-events: auto;
			}
		}
	}

	@media (hover: none), (pointer: coarse) {
		.docs-demo-preview pre > :global(button) {
			opacity: 1;
			pointer-events: auto;
		}
	}
</style>
