---
import { Code } from 'astro:components';
import bladesStyles from '@anyblades/blades/layered/blades.layered?inline';
// Inline the font binary too: the demo iframe is sandboxed (opaque origin), so any
// url() pointing at the dev server or a built asset is a cross-origin font fetch —
// blocked in dev and CORS-rejected in production. A data URL needs no request.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?inline';
import typographyStyles from '../assets/roles/typography.css?inline';
import a11yStyles from '../assets/roles/a11y.css?inline';
import knivesStyles from '../assets/roles/knives.css?inline';
import CopyButton from './CopyButton.astro';

// Mirrors @fontsource-variable/inter's latin block, with the binary inlined as a data URL.
const interStyles = `@font-face {
	font-family: 'Inter Variable';
	font-style: normal;
	font-display: swap;
	font-weight: 100 900;
	src: url("${interLatin}") format('woff2-variations');
	unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}`;

interface Props {
	title?: string;
	html?: string;
	css?: string;
	js?: string;
	rtl?: boolean;
	size?: number;
}

const { title = '', size = 22, html = '', css = '', js = '', rtl = false } = Astro.props;
const srcdoc = `<!doctype html>
<html lang="en" style="height: 100%;" ${rtl ? 'dir="rtl"' : ''}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">
		<style>${bladesStyles}\n${interStyles}\n${typographyStyles}\n${a11yStyles}\n${knivesStyles}\n${css}</style>
	</head>
	<body style="height: 100%; min-height: 200px; display: grid; place-items: start center; padding: 2rem 1rem;">
		${html}
		${js ? `<script>${js}</script>` : ''}
	</body>
</html>`;

const themes = { light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' } as const;
const sourceCode = html || css;
const sourceLabel = html ? 'HTML' : 'CSS';
const sourceLang: 'html' | 'css' = html ? 'html' : 'css';
---

<section class="docs-demo-preview">
	{html && css ? (
		<iframe
			title={`${title} preview (${rtl ? 'RTL' : 'LTR'})`}
			sandbox="allow-scripts"
			loading="lazy"
			srcdoc={srcdoc}
			style={`height: ${size}rem;`}
		></iframe>
	) : (
		<>
			{html || css ? (
				<div class="docs-demo-preview__code">
					<Code code={sourceCode} lang={sourceLang} themes={themes} defaultColor={false} />
					<CopyButton label={sourceLabel} getText={() => sourceCode} />
				</div>
			) : (
				<p>No preview available.</p>
			)}
		</>
	)}
</section>

<style>
	.docs-demo-preview {
		margin-block: 2rem;

		iframe {
			display: block;
			width: 100%;
			border: var(--pico-border-width) solid var(--pico-muted-border-color);
			border-radius: var(--pico-border-radius);
			background: var(--pico-background-color);
			margin-bottom: var(--pico-typography-spacing-vertical);
		}
	}

	.docs-demo-preview__code {
		position: relative;
		overflow: hidden;

		> :global(.astro-code) {
			max-height: 24rem;
			overflow-y: auto;
		}

		> :global(button) {
			position: absolute;
			top: 1rem;
			right: 1rem;
			opacity: 0;
			pointer-events: none;
		}

		&:hover > :global(button),
		&:focus-within > :global(button) {
			opacity: 1;
			pointer-events: auto;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.docs-demo-preview__code > :global(button) {
			opacity: 1;
			pointer-events: auto;
		}
	}
</style>
