---
import { Code } from 'astro:components';
import bladesStyles from '@anyblades/blades/css/layered/blades.layered.css?inline';
// Inline the font binary too: the demo iframe is sandboxed (opaque origin), so any
// url() pointing at the dev server or a built asset is a cross-origin font fetch —
// blocked in dev and CORS-rejected in production. A data URL needs no request.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?inline';
import typographyStyles from '../assets/roles/typography.css?inline';
import a11yStyles from '../assets/roles/a11y.css?inline';
import knivesStyles from '../assets/roles/knives.css?inline';
import CopyButton from './CopyButton.astro';

// Mirrors @fontsource-variable/inter's latin block, with the binary inlined as a data URL.
const interStyles = `@font-face {
	font-family: 'Inter Variable';
	font-style: normal;
	font-display: swap;
	font-weight: 100 900;
	src: url("${interLatin}") format('woff2-variations');
	unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}`;

interface Props {
	title?: string;
	md?: string;
	html?: string;
	css?: string;
	js?: string;
	rtl?: boolean;
	size?: number;
	/** Any valid `place-items` value; controls where the demo sits in the iframe. */
	placeItems?: string;
	/** Hide the Sources accordion; sources show by default. */
	skipSources?: boolean;
}

const {
	title = '',
	size = 22,
	md = '',
	html = '',
	css = '',
	js = '',
	rtl = false,
	placeItems = 'center',
	skipSources = false,
} = Astro.props;
const srcdoc = `<!doctype html>
<html lang="en" style="height: 100%;" ${rtl ? 'dir="rtl"' : 'dir="ltr"'}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">
		<script>
			// This frame is its own document, so the page's data-theme never reaches
			// it. Its name carries the page theme set by DocsDemoPreview before the
			// frame loads; later changes arrive as messages. Blades resolves its
			// palette (and the native select popup) from the resulting color-scheme.
			(() => {
				const apply = (theme) => {
					if (theme === 'light' || theme === 'dark') {
						document.documentElement.dataset.theme = theme;
					} else if (theme === 'system') {
						delete document.documentElement.dataset.theme;
					}
				};

				apply(window.name);

				addEventListener('message', (event) => {
					if (event.source !== window.parent) return;

					apply(event.data && event.data.knivesTheme);
				});
			})();
		</script>
		<style>${bladesStyles}\n${interStyles}\n${typographyStyles}\n${a11yStyles}\n${knivesStyles}\n${css}</style>
	</head>
	<body style="height: 100%; min-height: 200px; display: grid; place-items: ${placeItems}; padding: 2rem;">
		${html}
		${js ? `<script>${js}</script>` : ''}
	</body>
</html>`;

const themes = { light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' } as const;

type Source = { label: string; code: string; lang: 'markdown' | 'html' | 'css' | 'javascript' };

const allSources: Source[] = [
	{ label: 'Markdown', code: md, lang: 'markdown' },
	{ label: 'HTML', code: html, lang: 'html' },
	{ label: 'CSS', code: css, lang: 'css' },
	{ label: 'JavaScript', code: js, lang: 'javascript' },
];
const sources = allSources.filter((source) => source.code !== '');
const showSources = !skipSources && sources.length > 0;
---

<section class="docs-demo-preview" tabindex="0">
	<div class={`docs-demo-preview__frame${showSources ? ' docs-demo-preview__frame--sources' : ''}`}>
		{html && css && <iframe
			title={`${title} preview (${rtl ? 'RTL' : 'LTR'})`}
			sandbox="allow-scripts"
			loading="lazy"
			data-docs-demo-frame
			srcdoc={srcdoc}
			style={`height: ${size}rem;`}
		></iframe>}

		{showSources && (
			<details class="docs-demo-preview__sources">
				<summary>Sources</summary>
				{sources.map((source) => (
					<details class="docs-demo-preview__code">
						<summary>{source.label}</summary>
						<div class="docs-demo-preview__code-body">
							<Code code={source.code} lang={source.lang} themes={themes} defaultColor={false} />
							<CopyButton label={source.label} getText={() => source.code} />
						</div>
					</details>
				))}
			</details>
		)}

		{!html && !css && !showSources && <p>No preview available.</p>}
	</div>
</section>

<script>
	// Demo iframes are separate documents: the page's data-theme never reaches
	// them. Name each frame with the current theme before its lazy load starts
	// (the frame applies it while parsing), then message loaded frames whenever
	// the theme changes. Without this, their controls and native select popups
	// follow the OS preference instead of the site toggle.
	(() => {
		const currentTheme = () => document.documentElement.dataset.theme || 'system';
		const frames = () => document.querySelectorAll<HTMLIFrameElement>('[data-docs-demo-frame]');

		const sync = (frame: HTMLIFrameElement) => {
			frame.contentWindow?.postMessage({ knivesTheme: currentTheme() }, '*');
		};

		for (const frame of frames()) {
			frame.name = currentTheme();
			frame.addEventListener('load', () => sync(frame));
			sync(frame);
		}

		new MutationObserver(() => {
			for (const frame of frames()) {
				frame.name = currentTheme();
				sync(frame);
			}
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	})();
</script>

<style>
	.docs-demo-preview {
		margin-block: 2rem;

		iframe {
			display: block;
			width: 100%;
			border: var(--pico-border-width) solid var(--pico-muted-border-color);
			border-radius: var(--pico-border-radius);
			background: var(--pico-background-color);
			margin-bottom: var(--pico-typography-spacing-vertical);
		}
	}

	.docs-demo-preview__frame--sources {
		overflow: clip;

		iframe {
			border: 0;
			border-bottom: var(--pico-border-width) solid var(--pico-muted-border-color);
			border-radius: 0;
			margin-bottom: 0;
		}

		details {
			/* Blades spaces details with a bottom margin; use symmetric padding instead. */
			margin-bottom: 0;
			padding-block: calc(var(--pico-spacing) * 0.5);
		}

		summary {
			padding-block: var(--pico-form-element-spacing-vertical);
		}

		/* Plain top/bottom rules on mobile; a full frame once there is room. */
		@media (width < 1100px) {
			border-block: var(--pico-border-width) solid var(--pico-muted-border-color);
		}

		@media (min-width: 1100px) {
			border: var(--pico-border-width) solid var(--pico-muted-border-color);
			border-radius: var(--pico-border-radius);
		}
	}

	.docs-demo-preview__code-body {
		position: relative;
		overflow: hidden;

		> :global(.astro-code) {
			max-height: 24rem;
			overflow-y: auto;
		}

		> :global(button) {
			position: absolute;
			top: 1rem;
			right: 1rem;
			opacity: 0;
			pointer-events: none;
		}

		&:hover > :global(button),
		&:focus-within > :global(button) {
			opacity: 1;
			pointer-events: auto;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.docs-demo-preview__code-body > :global(button) {
			opacity: 1;
			pointer-events: auto;
		}
	}
</style>
