---
import { SITE_AUTHOR, SITE_AUTHOR_URL, SITE_REPO_URL } from '../consts';

const today = new Date();
---

<footer class="container">
	<p>
		&copy; {today.getFullYear()}{' '}
		<a class="contrast" href={SITE_AUTHOR_URL}>
			{SITE_AUTHOR}
		</a>
		.{' '}
		<a class="contrast" href={SITE_REPO_URL + '/blob/main/LICENSE'}>
			MIT
		</a>
		.
	</p>
</footer>
