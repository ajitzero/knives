---
interface Props {
	label: string;
	getText: () => string;
}

const { label, getText } = Astro.props;
const copyText = JSON.stringify(getText());
---

<button
	class="docs-copy-button contrast"
	type="button"
	data-copy-text={copyText}
	data-copy-label={label}
	aria-label={`Copy ${label}`}
>
	<svg
		class="docs-copy-button__icon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		focusable="false"
	>
		<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
		<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
	</svg>
	<svg
		class="docs-copy-button__check-icon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		focusable="false"
	>
		<path d="M20 6 9 17l-5-5"></path>
	</svg>
</button>

<script>
	let liveRegion: HTMLElement | null = null;

	function getLiveRegion(): HTMLElement {
		if (!liveRegion) {
			liveRegion = document.createElement('p');
			liveRegion.className = 'docs-copy-button__status';
			liveRegion.setAttribute('role', 'status');
			document.body.append(liveRegion);
		}

		return liveRegion;
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('.docs-copy-button')) {
		const text = JSON.parse(button.dataset.copyText ?? '""') as string;
		const label = button.dataset.copyLabel ?? 'source';
		let timeout: number | undefined;

		button.addEventListener('click', async () => {
			if (timeout !== undefined) window.clearTimeout(timeout);

			let copied = false;
			try {
				await navigator.clipboard.writeText(text);
				copied = true;
			} catch {
				copied = false;
			}

			button.toggleAttribute('data-copied', copied);
			getLiveRegion().textContent = copied
				? `Copied ${label} source.`
				: `Could not copy ${label} source. Copy it from the code block instead.`;

			timeout = window.setTimeout(() => {
				button.toggleAttribute('data-copied', false);
				getLiveRegion().textContent = '';
			}, 1800);
		});
	}
</script>

<style>
	button {
		svg {
			width: 1em;
			height: 1em;
		}

		.docs-copy-button__check-icon {
			display: none;
			color: color-mix(in srgb, var(--pico-ins-color) 50%, white 50%);
		}
	}

	button[data-copied] {
		.docs-copy-button__icon {
			display: none;
		}

		.docs-copy-button__check-icon {
			display: inline;
		}
	}
</style>

<style is:global>
	.docs-copy-button__status {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
