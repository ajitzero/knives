---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const snippets = (await getCollection('snippets')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title={`Snippets | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main>
		<hgroup>
			<h2 id="snippets">Snippets</h2>
			<p>{snippets.length} snippets.</p>
		</hgroup>

		{snippets.length > 0 ? (
			<ul>
				{snippets.map((snippet) => (
					<li>
						<article>
							<hgroup>
								<h3>
									<a href={`/snippets/${snippet.id}/`}>{snippet.data.title}</a>
								</h3>
							</hgroup>
							<p>{snippet.data.description}</p>
						</article>
					</li>
				))}
			</ul>
		) : (
			<p>No snippets yet.</p>
		)}
	</main>
</BaseLayout>
