---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DocsDemoPreview from '../../components/DocsDemoPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSnippetSources } from '../../snippets/sources';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const snippets = await getCollection('snippets');

	return snippets.map((snippet) => {
		return {
			params: { slug: snippet.id },
			props: { snippet, sources: getSnippetSources(snippet.id) },
		};
	});
}

type Props = {
	snippet: CollectionEntry<'snippets'>;
	sources: ReturnType<typeof getSnippetSources>;
};

const { snippet, sources } = Astro.props;
const { Content } = await render(snippet);
---

<BaseLayout title={`${snippet.data.title} | ${SITE_TITLE}`} description={snippet.data.description}>
	<main>
		<hgroup>
			<h2 id={snippet.id}>{snippet.data.title}</h2>
			<p>{snippet.data.stage.toUpperCase()}</p>
		</hgroup>
		<p>{snippet.data.description}</p>

		<h2 id="preview">Preview</h2>
		<DocsDemoPreview
			title={snippet.data.title}
			size={snippet.data.size}
			html={sources.html}
			css={sources.css}
			js={sources.js}
		/>

		<h3 id="html">HTML</h3>
		<DocsDemoPreview html={sources.html} />

		<h3 id="css">CSS</h3>
		<DocsDemoPreview css={sources.css} />

		<Content />

		<h2 id="rtl">RTL</h2>
		<p>
			Add <code>dir="rtl"</code> to any parent element to apply the changes.
		</p>
		<DocsDemoPreview
			rtl
			title={snippet.data.title}
			size={snippet.data.size}
			html={sources.html}
			css={sources.css}
			js={sources.js}
		/>
	</main>
</BaseLayout>

<style>
	hgroup h2 {
		/* h1 styling for h2 */
		--pico-font-size: 2rem;
		--pico-line-height: 1.125;
		--pico-typography-spacing-top: 3rem;
	}
</style>
