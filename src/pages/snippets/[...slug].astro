---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DocsDemoPreview from '../../components/DocsDemoPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSnippetSources } from '../../snippets/sources';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const snippets = (await getCollection('snippets')).sort((a, b) =>
		a.data.title.localeCompare(b.data.title),
	);

	return snippets.map((snippet, index) => {
		return {
			params: { slug: snippet.id },
			props: {
				snippet,
				sources: getSnippetSources(snippet.id),
				previous: snippets[index - 1],
				next: snippets[index + 1],
			},
		};
	});
}

type Props = {
	snippet: CollectionEntry<'snippets'>;
	sources: ReturnType<typeof getSnippetSources>;
	previous?: CollectionEntry<'snippets'>;
	next?: CollectionEntry<'snippets'>;
};

const { snippet, sources, previous, next } = Astro.props;
const { Content } = await render(snippet);
---

<BaseLayout title={`${snippet.data.title} | ${SITE_TITLE}`} description={snippet.data.description}>
	<main>
		<hgroup>
			<h2 id={snippet.id}>{snippet.data.title}</h2>
			<p>{snippet.data.stage.toUpperCase()}</p>
		</hgroup>
		<p>{snippet.data.description}</p>

		<h2 id="preview">Preview</h2>
		<DocsDemoPreview
			title={snippet.data.title}
			size={snippet.data.size}
			html={sources.html}
			css={sources.css}
			js={sources.js}
		/>

		{sources.md && (
			<>
				<h3 id="md">Markdown</h3>
				<DocsDemoPreview md={sources.md} />
			</>
		)}

		<h3 id="html">HTML</h3>
		<DocsDemoPreview html={sources.html} />

		<h3 id="css">CSS</h3>
		<DocsDemoPreview css={sources.css} />

		<Content />

		<h2 id="rtl">RTL</h2>
		<p>
			Add <code>dir="rtl"</code> to any parent element to apply the changes.
		</p>
		<DocsDemoPreview
			rtl
			title={snippet.data.title}
			size={snippet.data.size}
			html={sources.html}
			css={sources.css}
			js={sources.js}
		/>

		<nav aria-label="Snippet pagination">
			{previous ? (
				<a href={`/snippets/${previous.id}/`} role="button">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-left"
					>
						<path d="m15 18-6-6 6-6" />
					</svg>
					<span>Previous: {previous.data.title}</span>
				</a>
			) : (
				<button disabled class="secondary">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-left"
					>
						<path d="m15 18-6-6 6-6" />
					</svg>
					<span>Previous</span>
				</button>
			)}
			{next ? (
				<a href={`/snippets/${next.id}/`} role="button">
					<span> Next: {next.data.title}</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-right"
					>
						<path d="m9 18 6-6-6-6" />
					</svg>
				</a>
			) : (
				<button disabled class="secondary">
					<span>Next</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-right"
					>
						<path d="m9 18 6-6-6-6" />
					</svg>
				</button>
			)}
		</nav>
	</main>
</BaseLayout>

<style>
	main > nav > :is(button, [role='button']) {
		display: flex;
		align-items: center;
		gap: var(--knives-menu-gap);

		> svg {
			--icon-scale: 1.4;
			width: calc(var(--knives-icon-size) * var(--icon-scale));
			height: calc(var(--knives-icon-size) * var(--icon-scale));
		}
	}
</style>
