---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import DocsDemoPreview from '../../components/DocsDemoPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSnippetSources } from '../../snippets/sources';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const snippets = (await getCollection('snippets')).sort((a, b) =>
		a.data.title.localeCompare(b.data.title),
	);

	return snippets.map((snippet, index) => {
		return {
			params: { slug: snippet.id },
			props: {
				snippet,
				sources: getSnippetSources(snippet.id, snippet.data.variants),
				previous: snippets[index - 1],
				next: snippets[index + 1],
			},
		};
	});
}

type Props = {
	snippet: CollectionEntry<'snippets'>;
	sources: ReturnType<typeof getSnippetSources>;
	previous?: CollectionEntry<'snippets'>;
	next?: CollectionEntry<'snippets'>;
};

const { snippet, sources, previous, next } = Astro.props;
const { Content } = await render(snippet);
const variantMode = !sources.legacy;

const variantDocs = new Map<string, Awaited<ReturnType<typeof render>>['Content']>();

for (const variant of sources.variants) {
	if (!variant.md) continue;

	const entry = await getEntry('snippetDocs', `${snippet.id}/${variant.id}`.toLowerCase());

	if (entry) {
		variantDocs.set(variant.id, (await render(entry)).Content);
	}
}
---

<BaseLayout title={`${snippet.data.title} | ${SITE_TITLE}`} description={snippet.data.description}>
	<main>
		<hgroup>
			<h2 id={snippet.id}>{snippet.data.title}</h2>
			<p>{snippet.data.stage.toUpperCase()}</p>
		</hgroup>
		<p>{snippet.data.description}</p>

		{variantMode ? (
			<>
				{sources.variants.map((variant) => {
					const VariantContent = variantDocs.get(variant.id);

					return (
						<section aria-labelledby={variant.id}>
							<h3 id={variant.id}>{variant.label}</h3>
							{VariantContent && <VariantContent />}
							<DocsDemoPreview
								title={`${snippet.data.title} - ${variant.label}`}
								size={snippet.data.size}
								placeItems={snippet.data.placeItems}
								md={sources.md}
								html={variant.html}
								css={variant.css}
								js={variant.js}
							/>
						</section>
					);
				})}

				<Content />

				<h2 id="rtl">RTL</h2>
				<p>
					Add <code>dir="rtl"</code> to any parent element to apply the changes.
				</p>
				{sources.variants.map((variant) => (
					<Fragment>
						<h3 id={`${variant.id}-rtl`}>{variant.label}</h3>
						<DocsDemoPreview
							rtl
							skipSources
							title={`${snippet.data.title} - ${variant.label}`}
							size={snippet.data.size}
							placeItems={snippet.data.placeItems}
							html={variant.html}
							css={variant.css}
							js={variant.js}
						/>
					</Fragment>
				))}
			</>
		) : (
			<>
				<h2 id="preview">Preview</h2>
				<DocsDemoPreview
					title={snippet.data.title}
					size={snippet.data.size}
					placeItems={snippet.data.placeItems}
					md={sources.md}
					html={sources.html}
					css={sources.css}
					js={sources.js}
				/>

				<Content />

				<h2 id="rtl">RTL</h2>
				<p>
					Add <code>dir="rtl"</code> to any parent element to apply the changes.
				</p>
				<DocsDemoPreview
					rtl
					skipSources
					title={snippet.data.title}
					size={snippet.data.size}
					placeItems={snippet.data.placeItems}
					html={sources.html}
					css={sources.css}
					js={sources.js}
				/>
			</>
		)}

		<nav aria-label="Snippet pagination">
			{previous ? (
				<a href={`/snippets/${previous.id}/`} role="button">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-left"
					>
						<path d="m15 18-6-6 6-6" />
					</svg>
					<span>
						<small>Previous</small>
						<span>{previous.data.title}</span>
					</span>
				</a>
			) : (
				<button disabled class="secondary" aria-label="No previous page, you are on the first page">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-left"
					>
						<path d="m15 18-6-6 6-6" />
					</svg>
				</button>
			)}
			{next ? (
				<a href={`/snippets/${next.id}/`} role="button">
					<span>
						<small>Next</small>
						<span>{next.data.title}</span>
					</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-right"
					>
						<path d="m9 18 6-6-6-6" />
					</svg>
				</a>
			) : (
				<button disabled class="secondary" aria-label="No next page, you are on the last page">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-right"
					>
						<path d="m9 18 6-6-6-6" />
					</svg>
				</button>
			)}
		</nav>
	</main>
</BaseLayout>

<style>
	main > nav > :is(button, [role='button']) {
		display: flex;
		align-items: center;
		gap: var(--knives-menu-gap);

		> svg {
			--icon-scale: 1.4;
			width: calc(var(--knives-icon-size) * var(--icon-scale));
			height: calc(var(--knives-icon-size) * var(--icon-scale));
		}

		> span {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			line-height: 1.25;
		}
	}
</style>
